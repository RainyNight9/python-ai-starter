# 聊天 Completions 鉴权 Key，用于 OpenAI 官方或兼容网关。
OPENAI_API_KEY=your_chat_api_key_here

# 聊天 Completions 网关，例如 OpenAI 官方、DashScope 兼容模式或其他 OpenAI-compatible 网关。
OPENAI_BASE_URL=https://api.openai.com/v1

# 聊天模型，例如：gpt-4o-mini / qwen-plus / qwen3.6-35b-a3b。
MODEL_NAME=gpt-4o-mini

# 可选。数据库连接 URL，默认使用本地 SQLite 文件。
DATABASE_URL=sqlite:///./ai_platform.db

# RAG / Embedding 鉴权 Key。
# 如果不填写，代码会回退使用 OPENAI_API_KEY，方便聊天和向量都走同一厂商时快速跑通。
EMBEDDING_API_KEY=your_embedding_api_key_here

# 向量化模型（DashScope 推荐：text-embedding-v3 / text-embedding-v4）。
EMBEDDING_MODEL=text-embedding-v3

# RAG 检索与切片参数。
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
