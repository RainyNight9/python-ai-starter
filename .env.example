# 聊天（AsyncOpenAI）与 RAG 向量（DashScope Embedding Bearer）当前共用此变量。
# 若启用上传文档 / RAG，请确保该 Key 对 DashScope 文本向量 API 有效。
OPENAI_API_KEY=your_api_key_here

# 聊天 Completions 网关（OpenAI 官方或兼容中转）
OPENAI_BASE_URL=https://api.openai.com/v1

# 聊天模型，例如：gpt-4o-mini / qwen-plus / qwen3.6-35b-a3b (取决于你的提供方)
MODEL_NAME=gpt-4o-mini

# 向量化模型（DashScope 推荐：text-embedding-v3 / text-embedding-v4）
EMBEDDING_MODEL=text-embedding-v3
